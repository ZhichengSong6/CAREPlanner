<launch>
  <arg name="world_file"
       default="$(find arm_description)/worlds/maixsense_empty.world" />

  <arg name="robot_urdf"
       default="$(find arm_description)/urdf/Arm.urdf" />

  <arg name="model_name"
       default="care_arm" />

  <arg name="paused"
       default="false" />

  <arg name="use_sim_time"
       default="true" />

  <arg name="gazebo_gui"
       default="true" />

  <arg name="verbose"
       default="false" />

  <arg name="use_joint_state_gui"
       default="true" />

  <arg name="use_rviz"
       default="true" />

  <arg name="rviz_config"
       default="$(find arm_description)/rviz/care_arm_phase1.rviz" />

  <!-- Load Arm.urdf into /robot_description once for both Gazebo spawning and RViz/TF. -->
  <include file="$(find arm_description)/launch/load_robot_description.launch">
    <arg name="robot_urdf" value="$(arg robot_urdf)" />
  </include>

  <!-- Start Gazebo with the perception test world. -->
  <include file="$(find arm_description)/launch/gazebo_maixsense_world.launch">
    <arg name="world_file" value="$(arg world_file)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="gui" value="$(arg gazebo_gui)" />
    <arg name="verbose" value="$(arg verbose)" />
  </include>

  <!-- Spawn the arm into Gazebo.
       We use -param robot_description here, but do not load controllers in M14. -->
  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_care_arm"
        output="screen"
        args="-urdf
              -param robot_description
              -model $(arg model_name)
              -x 0.0
              -y 0.0
              -z 0.0
              -R 0.0
              -P 0.0
              -Y 0.0" />

  <!-- Phase-I/M14 RViz TF source.
       Before ros_control is added, this is only for visualization/debug.
       Gazebo will not follow this GUI yet. -->
  <node if="$(arg use_joint_state_gui)"
        pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui"
        name="joint_state_publisher_gui"
        output="screen" />

  <node unless="$(arg use_joint_state_gui)"
        pkg="joint_state_publisher"
        type="joint_state_publisher"
        name="joint_state_publisher"
        output="screen" />

  <!-- Publish /tf for RViz from /joint_states and /robot_description. -->
  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen" />

  <!-- RViz with saved config. -->
  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>