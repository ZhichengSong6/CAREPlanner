<launch>
  <arg name="world_file" default="$(find arm_description)/worlds/maixsense_empty.world" />
  <arg name="robot_urdf" default="$(find arm_description)/urdf/Arm.urdf" />
  <arg name="model_name" default="care_arm" />
  <arg name="paused" default="false" />
  <arg name="use_sim_time" default="true" />
  <arg name="gazebo_gui" default="true" />

  <!-- RViz remains part of the normal simulation startup from the user's
       perspective, but it runs in its own session after the simulation/control
       stack becomes ready. A roslaunch-managed wrapper stays alive while RViz
       is running. On roslaunch shutdown, the wrapper forwards termination to
       the complete RViz process group, so Ctrl+C closes RViz together with the
       rest of the simulation while retaining the process/session isolation that
       has been more stable on this system. RViz stays on its default OpenGL path. -->
  <arg name="use_rviz" default="true" />
  <arg name="rviz_ready_timeout" default="30.0" />
  <arg name="rviz_post_ready_delay" default="0.5" />
  <arg name="rviz_config" default="$(find arm_description)/rviz/care_arm_phase1.rviz" />
  <arg name="verbose" default="false" />

  <include file="$(find arm_description)/launch/load_robot_description.launch">
    <arg name="robot_urdf" value="$(arg robot_urdf)" />
  </include>

  <include file="$(find arm_description)/launch/gazebo_maixsense_world.launch">
    <arg name="world_file" value="$(arg world_file)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="gui" value="$(arg gazebo_gui)" />
    <arg name="verbose" value="$(arg verbose)" />
  </include>

  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_care_arm"
        output="screen"
        args="-urdf
              -param robot_description
              -model $(arg model_name)
              -x 0.0
              -y 0.0
              -z 0.0
              -R 0.0
              -P 0.0
              -Y 0.0" />

  <rosparam file="$(find arm_description)/config/controllers.yaml" command="load" />

  <node pkg="controller_manager"
        type="spawner"
        name="controller_spawner"
        ns="/care_arm"
        output="screen"
        args="joint_state_controller arm_group_velocity_controller" />

  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen">
    <remap from="joint_states" to="/care_arm/joint_states" />
  </node>

  <!-- The wrapper is the roslaunch child. RViz itself runs under setsid in an
       independent session/process group. The wrapper waits for RViz and traps
       SIGINT/SIGTERM so a normal roslaunch Ctrl+C also terminates that group. -->
  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(arg rviz_config)"
        launch-prefix="bash -c 'timeout $(arg rviz_ready_timeout)s rostopic echo -n 1 /care_arm/joint_states &gt;/dev/null 2&gt;&amp;1 || true; sleep $(arg rviz_post_ready_delay); setsid &quot;$0&quot; &quot;$@&quot; &gt;&quot;$HOME/.ros/careplanner_rviz_detached.log&quot; 2&gt;&amp;1 &lt;/dev/null &amp; rviz_pid=$!; trap &quot;kill -TERM -- -$rviz_pid 2&gt;/dev/null || true&quot; INT TERM HUP EXIT; wait $rviz_pid; status=$?; trap - INT TERM HUP EXIT; exit $status' "
        output="screen" />
</launch>
