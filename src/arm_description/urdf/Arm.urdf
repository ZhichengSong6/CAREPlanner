    </actuator>
  </transmission>

  <!-- ================================================================ -->
  <!-- Gazebo visual/sensor links gravity settings                      -->
  <!-- In M15 we use ros_control VelocityJointInterface for the 7 arm    -->
  <!-- joints. These gravity tags are kept from the previous visualization -->
  <!-- setup so the auxiliary sensor links do not sag during simulation. -->
  <!-- ================================================================ -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>
