<launch>
  <arg name="geometry_backend" default="samples" />
  <arg name="primitive_urdf_file" default="$(find arm_description)/urdf/Arm_with_self_filter_collision.urdf" />
  <arg name="body_samples_file"
       default="$(find care_confidence_map)/config/body_samples.yaml" />
  <arg name="base_frame" default="base_link" />
  <arg name="target_topic"
       default="/care_planner/active_sensing/target_point" />
  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />
  <arg name="visibility_threshold" default="0.50" />
  <arg name="rate" default="50.0" />
  <arg name="sweep_extra_margin" default="0.0" />
  <arg name="trial_label" default="trial" />
  <arg name="lambda_vis" default="0.0" />
  <arg name="output_root"
       default="$(find egocentric_arm_planner)/../../outputs/phase_b2_v2_ab" />

  <node pkg="care_confidence_map"
        type="executed_vbc_logger_node.py"
        name="executed_vbc_logger"
        output="screen">
    <param if="$(eval arg('geometry_backend') == 'samples')" name="body_samples_file" value="$(arg body_samples_file)" />
    <param name="geometry_backend" value="$(arg geometry_backend)" />
    <param name="primitive_urdf_file" value="$(arg primitive_urdf_file)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="target_topic" value="$(arg target_topic)" />
    <param name="confidence_query_service" value="$(arg confidence_query_service)" />
    <param name="visibility_threshold" value="$(arg visibility_threshold)" />
    <param name="rate" value="$(arg rate)" />
    <param name="sweep_extra_margin" value="$(arg sweep_extra_margin)" />
    <param name="trial_label" value="$(arg trial_label)" />
    <param name="lambda_vis" value="$(arg lambda_vis)" />
    <param name="output_root" value="$(arg output_root)" />
    <rosparam param="ignored_links">[base_link, link1]</rosparam>
  </node>
</launch>
