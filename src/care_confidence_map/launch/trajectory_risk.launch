<launch>
  <!-- ========================= -->
  <!-- Files / frames             -->
  <!-- ========================= -->

  <arg name="robot_urdf_file"
       default="$(find arm_description)/urdf/Arm_with_self_filter_collision.urdf" />

  <arg name="body_samples_file"
       default="$(find care_confidence_map)/config/body_samples.yaml" />

  <!-- YAML config for things that should be edited without recompiling,
       especially trajectory_risk/ignored_risk_links. -->
  <arg name="trajectory_risk_config_file"
       default="$(find care_confidence_map)/config/trajectory_risk.yaml" />

  <arg name="base_frame" default="base_link" />

  <!-- ========================= -->
  <!-- Input / service topics     -->
  <!-- ========================= -->

  <arg name="input_trajectory_topic"
       default="/care_planner/task_trajectory" />

  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />

  <!-- ========================= -->
  <!-- Evaluation parameters      -->
  <!-- ========================= -->

  <arg name="eval_rate" default="20.0" />
  <arg name="max_eval_timesteps" default="50" />
  <arg name="query_timeout" default="0.10" />

  <!-- Marker publish rate is throttled separately from risk eval rate. -->
  <arg name="marker_publish_rate" default="2.0" />

  <arg name="marker_alpha" default="0.45" />
  <arg name="worst_marker_alpha" default="0.85" />
  <arg name="attribution_marker_alpha" default="0.90" />

  <arg name="show_full_trajectory_markers" default="true" />
  <arg name="show_worst_timestep_markers" default="true" />
  <arg name="show_attribution_markers" default="true" />

  <arg name="top_k_samples" default="20" />

  <arg name="risk_frontier_threshold" default="0.30" />
  <arg name="risk_frontier_window_steps" default="5" />
  <arg name="safe_prefix_margin_steps" default="2" />
  <arg name="frontier_confidence_threshold" default="0.50" />
  <arg name="frontier_gap_threshold" default="0.50" />
  <arg name="frontier_radius_margin" default="0.05" />

  <arg name="evaluate_stale_trajectory" default="true" />
  <arg name="stale_trajectory_timeout" default="1.0" />

  <!-- ========================= -->
  <!-- Trajectory risk node       -->
  <!-- ========================= -->

  <node pkg="care_confidence_map"
        type="trajectory_risk_node"
        name="trajectory_risk_node"
        output="screen">

    <!-- Load YAML first. Parameters below can override YAML values if needed. -->
    <rosparam command="load" file="$(arg trajectory_risk_config_file)" />

    <param name="trajectory_risk/robot_urdf_file"
           value="$(arg robot_urdf_file)" />

    <param name="trajectory_risk/body_samples_file"
           value="$(arg body_samples_file)" />

    <param name="trajectory_risk/base_frame"
           value="$(arg base_frame)" />

    <param name="trajectory_risk/input_trajectory_topic"
           value="$(arg input_trajectory_topic)" />

    <param name="trajectory_risk/confidence_query_service"
           value="$(arg confidence_query_service)" />

    <param name="trajectory_risk/eval_rate"
           value="$(arg eval_rate)" />

    <param name="trajectory_risk/max_eval_timesteps"
           value="$(arg max_eval_timesteps)" />

    <param name="trajectory_risk/query_timeout"
           value="$(arg query_timeout)" />

    <param name="trajectory_risk/marker_publish_rate"
           value="$(arg marker_publish_rate)" />

    <param name="trajectory_risk/marker_alpha"
           value="$(arg marker_alpha)" />

    <param name="trajectory_risk/worst_marker_alpha"
           value="$(arg worst_marker_alpha)" />

    <param name="trajectory_risk/attribution_marker_alpha"
           value="$(arg attribution_marker_alpha)" />

    <param name="trajectory_risk/show_full_trajectory_markers"
           value="$(arg show_full_trajectory_markers)" />

    <param name="trajectory_risk/show_worst_timestep_markers"
           value="$(arg show_worst_timestep_markers)" />

    <param name="trajectory_risk/show_attribution_markers"
           value="$(arg show_attribution_markers)" />

    <param name="trajectory_risk/top_k_samples"
           value="$(arg top_k_samples)" />

    <param name="trajectory_risk/risk_frontier_threshold"
        value="$(arg risk_frontier_threshold)" />

    <param name="trajectory_risk/risk_frontier_window_steps"
        value="$(arg risk_frontier_window_steps)" />

    <param name="trajectory_risk/safe_prefix_margin_steps"
        value="$(arg safe_prefix_margin_steps)" />

    <param name="trajectory_risk/frontier_confidence_threshold"
        value="$(arg frontier_confidence_threshold)" />

    <param name="trajectory_risk/frontier_gap_threshold"
        value="$(arg frontier_gap_threshold)" />

    <param name="trajectory_risk/frontier_radius_margin"
        value="$(arg frontier_radius_margin)" />

    <param name="trajectory_risk/evaluate_stale_trajectory"
           value="$(arg evaluate_stale_trajectory)" />

    <param name="trajectory_risk/stale_trajectory_timeout"
           value="$(arg stale_trajectory_timeout)" />
  </node>
</launch>
