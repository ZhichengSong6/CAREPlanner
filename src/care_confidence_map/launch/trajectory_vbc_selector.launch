<launch>
  <!-- VBC needs both robot body link frames and the eight ToF sensor frames.
       Use the complete Arm.urdf here; the self-filter collision URDF does not
       contain the ToF frames and would make the selector fail during startup. -->
  <arg name="robot_urdf_file"
       default="$(find arm_description)/urdf/Arm.urdf" />
  <arg name="body_samples_file"
       default="$(find care_confidence_map)/config/body_samples.yaml" />
  <arg name="config_file"
       default="$(find care_confidence_map)/config/trajectory_risk.yaml" />

  <arg name="base_frame" default="base_link" />
  <arg name="input_trajectory_topic"
       default="/care_planner/task_trajectory" />
  <arg name="output_target_topic"
       default="/care_planner/active_sensing/target_candidate" />
  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />
  <arg name="min_visibility_before_sweep_margin_s" default="0.30" />

  <node pkg="care_confidence_map"
        type="trajectory_vbc_selector_node"
        name="trajectory_vbc_selector_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />

    <param name="trajectory_vbc/robot_urdf_file"
           value="$(arg robot_urdf_file)" />
    <param name="trajectory_vbc/body_samples_file"
           value="$(arg body_samples_file)" />
    <param name="trajectory_vbc/base_frame"
           value="$(arg base_frame)" />
    <param name="trajectory_vbc/input_trajectory_topic"
           value="$(arg input_trajectory_topic)" />
    <param name="trajectory_vbc/output_target_topic"
           value="$(arg output_target_topic)" />
    <param name="trajectory_vbc/confidence_query_service"
           value="$(arg confidence_query_service)" />
    <param name="trajectory_vbc/min_visibility_before_sweep_margin_s"
           value="$(arg min_visibility_before_sweep_margin_s)" />
  </node>
</launch>
