<launch>
  <!-- VBC needs both robot body link frames and the eight ToF sensor frames. -->
  <arg name="robot_urdf_file"
       default="$(find arm_description)/urdf/Arm.urdf" />
  <arg name="body_samples_file"
       default="$(find care_confidence_map)/config/body_samples.yaml" />
  <arg name="config_file"
       default="$(find care_confidence_map)/config/trajectory_risk.yaml" />

  <arg name="base_frame" default="base_link" />
  <arg name="input_trajectory_topic"
       default="/care_planner/task_trajectory" />
  <arg name="predicted_trajectory_topic"
       default="/care_planner/mpc/predicted_trajectory" />
  <arg name="prefer_predicted_trajectory" default="false" />
  <arg name="predicted_trajectory_timeout" default="0.20" />

  <arg name="output_target_topic"
       default="/care_planner/active_sensing/target_candidate" />
  <arg name="candidate_active_topic"
       default="/care_planner/active_sensing/target_candidate_active" />
  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />
  <arg name="min_visibility_before_sweep_margin_s" default="0.30" />
  <!-- C5.29: temporal VBC checks the full body-sphere swept volume.
       Keep this aligned with the GCDF proximity margin. -->
  <arg name="swept_volume_margin_m" default="0.025" />

  <!-- The controlled C4.3 path already sets prefer_predicted_trajectory=true;
       the frozen C4.2 path leaves it false. Use that existing routing signal so
       the parent launch does not need another compatibility argument. -->
  <arg name="temporal_layer_mode" default="$(arg prefer_predicted_trajectory)" />

  <!-- Frozen C4.2 point-selector parameters. -->
  <arg name="primary_frontier_window_s" default="0.25" />
  <arg name="target_switch_hysteresis_s" default="0.05" />

  <!-- C4.3 bounded temporal clustering.  A value of 2 means one layer may
       contain violations whose first sweep indices span at most two original
       MPC prediction intervals (about 0.10 s for the current 0.05 s grid). -->
  <arg name="temporal_layer_mpc_steps" default="2" />
  <arg name="region_max_diameter_m" default="0.12" />
  <arg name="active_set_points_topic"
       default="/care_planner/trajectory_risk/vbc_active_set_points" />
  <arg name="active_set_bundle_topic"
       default="/care_planner/trajectory_risk/vbc_active_set_bundle" />
  <arg name="force_bootstrap_topic"
       default="/care_planner/trajectory_risk/force_bootstrap" />

  <node unless="$(arg temporal_layer_mode)"
        pkg="care_confidence_map"
        type="trajectory_vbc_selector_legacy_node"
        name="trajectory_vbc_selector_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="trajectory_vbc/robot_urdf_file" value="$(arg robot_urdf_file)" />
    <param name="trajectory_vbc/body_samples_file" value="$(arg body_samples_file)" />
    <param name="trajectory_vbc/base_frame" value="$(arg base_frame)" />
    <param name="trajectory_vbc/input_trajectory_topic" value="$(arg input_trajectory_topic)" />
    <param name="trajectory_vbc/predicted_trajectory_topic" value="$(arg predicted_trajectory_topic)" />
    <param name="trajectory_vbc/prefer_predicted_trajectory" value="$(arg prefer_predicted_trajectory)" />
    <param name="trajectory_vbc/predicted_trajectory_timeout" value="$(arg predicted_trajectory_timeout)" />
    <param name="trajectory_vbc/output_target_topic" value="$(arg output_target_topic)" />
    <param name="trajectory_vbc/candidate_active_topic" value="$(arg candidate_active_topic)" />
    <param name="trajectory_vbc/confidence_query_service" value="$(arg confidence_query_service)" />
    <param name="trajectory_vbc/min_visibility_before_sweep_margin_s" value="$(arg min_visibility_before_sweep_margin_s)" />
    <param name="trajectory_vbc/primary_frontier_window_s" value="$(arg primary_frontier_window_s)" />
    <param name="trajectory_vbc/target_switch_hysteresis_s" value="$(arg target_switch_hysteresis_s)" />
  </node>

  <node if="$(arg temporal_layer_mode)"
        pkg="care_confidence_map"
        type="trajectory_vbc_selector_temporal_cluster_node"
        name="trajectory_vbc_selector_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="trajectory_vbc/robot_urdf_file" value="$(arg robot_urdf_file)" />
    <param name="trajectory_vbc/body_samples_file" value="$(arg body_samples_file)" />
    <param name="trajectory_vbc/base_frame" value="$(arg base_frame)" />
    <param name="trajectory_vbc/input_trajectory_topic" value="$(arg input_trajectory_topic)" />
    <param name="trajectory_vbc/predicted_trajectory_topic" value="$(arg predicted_trajectory_topic)" />
    <param name="trajectory_vbc/prefer_predicted_trajectory" value="$(arg prefer_predicted_trajectory)" />
    <param name="trajectory_vbc/predicted_trajectory_timeout" value="$(arg predicted_trajectory_timeout)" />
    <param name="trajectory_vbc/output_target_topic" value="$(arg output_target_topic)" />
    <param name="trajectory_vbc/candidate_active_topic" value="$(arg candidate_active_topic)" />
    <param name="trajectory_vbc/confidence_query_service" value="$(arg confidence_query_service)" />
    <param name="trajectory_vbc/min_visibility_before_sweep_margin_s" value="$(arg min_visibility_before_sweep_margin_s)" />
    <param name="trajectory_vbc/swept_volume_margin_m" value="$(arg swept_volume_margin_m)" />
    <param name="trajectory_vbc/temporal_layer_mpc_steps" value="$(arg temporal_layer_mpc_steps)" />
    <param name="trajectory_vbc/region_max_diameter_m" value="$(arg region_max_diameter_m)" />
    <param name="trajectory_vbc/active_set_points_topic" value="$(arg active_set_points_topic)" />
    <param name="trajectory_vbc/active_set_bundle_topic" value="$(arg active_set_bundle_topic)" />
    <param name="trajectory_vbc/force_bootstrap_topic" value="$(arg force_bootstrap_topic)" />
  </node>
</launch>
