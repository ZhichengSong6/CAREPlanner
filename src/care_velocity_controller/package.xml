<?xml version="1.0"?>
<package format="2">
  <name>care_velocity_controller</name>
  <version>0.1.0</version>
  <description>Simulation velocity controller with stamped command expiry and latched braking.</description>
  <maintainer email="songzhicheng66@gmail.com">zhicheng</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>roscpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <export><controller_interface plugin="${prefix}/controller_plugins.xml" /></export>
</package>
