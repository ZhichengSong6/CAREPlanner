<?xml version="1.0"?>
<package format="2">
  <name>care_visibility_cdf</name>
  <version>0.0.1</version>
  <description>Offline visibility field, dataset, and neural CDF tools for CAREPlanner.</description>

  <maintainer email="songzhicheng66@gmail.com">zhicheng</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>arm_description</exec_depend>
</package>
