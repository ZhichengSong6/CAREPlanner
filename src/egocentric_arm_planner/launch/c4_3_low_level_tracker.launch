<launch>
  <arg name="config_file"
       default="$(find egocentric_arm_planner)/config/planner_phase1_c4_3_planner.yaml" />
  <arg name="base_frame" default="base_link" />
  <arg name="ee_frame" default="EE_link" />
  <arg name="input_trajectory"
       default="/care_planner/mpc/predicted_trajectory" />
  <arg name="output_velocity_command"
       default="/care_arm/arm_group_velocity_controller/command" />
  <arg name="use_acceleration_limiter" default="false" />
  <arg name="primitive_tracking_guard" default="false" />
  <arg name="certified_tracking_margin_m" default="0.020" />
  <arg name="primitive_urdf_file" default="$(find arm_description)/urdf/Arm_with_self_filter_collision.urdf" />
  <arg name="rate_limiter_output_velocity_command"
       default="/care_arm/arm_group_velocity_controller/command" />
  <arg name="rate_limiter_stamped_output_velocity_command" default="" />
  <arg name="require_execution_lease" default="false" />
  <arg name="require_prepared_execution" default="false" />
  <arg name="prepared_trajectory_topic" default="/care_planner/execution/staged_trajectory" />
  <arg name="prepared_status_topic" default="/care_planner/execution/tracker_preparation_status" />
  <arg name="execution_lease_topic" default="/care_arm/arm_group_velocity_controller/execution_lease" />
  <arg name="controller_state_topic" default="/care_arm/arm_group_velocity_controller/state" />
  <arg name="leased_desired_topic" default="/care_planner/execution/leased_velocity_desired" />
  <arg name="leased_controller_command_topic" default="/care_arm/arm_group_velocity_controller/command_leased" />
  <arg name="external_safety_hold_topic"
       default="/care_planner/execution_gcdf/hard_hold" />
  <arg name="vbc_safety_hold_topic"
       default="/care_planner/execution/predicted_vbc_verification_hold" />

  <!--
    C4.3 planner/controller split.

    CAREPlanner/MPC publishes a complete optimized receding-horizon trajectory.
    TrajectoryExecutionManager tracks the first short segment with feed-forward
    velocity plus position feedback.  In verified-commit mode its desired
    velocity is passed through a final per-joint acceleration/velocity envelope
    before the actuator; neither low-level node performs visibility/VBC planning.
  -->
  <node pkg="egocentric_arm_planner"
        type="trajectory_execution_manager_node"
        name="trajectory_execution_manager_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="ee_frame" value="$(arg ee_frame)" />
    <param name="execution/input_trajectory" value="$(arg input_trajectory)" />
    <param name="execution/primitive_tracking_guard" value="$(arg primitive_tracking_guard)" />
    <param name="execution/certified_tracking_margin_m" value="$(arg certified_tracking_margin_m)" />
    <param name="execution/primitive_urdf_file" value="$(arg primitive_urdf_file)" />
    <param name="execution/output_velocity_command" value="$(arg output_velocity_command)" />
    <param name="execution/limiter_output_command" value="$(arg rate_limiter_output_velocity_command)" />
    <param name="execution/require_command_lease" value="$(arg require_execution_lease)" />
    <param name="execution/require_prepared_execution" value="$(arg require_prepared_execution)" />
    <param name="execution/prepared_trajectory_topic" value="$(arg prepared_trajectory_topic)" />
    <param name="execution/prepared_status_topic" value="$(arg prepared_status_topic)" />
    <param name="execution/lease_topic" value="$(arg execution_lease_topic)" />
    <param name="execution/controller_state_topic" value="$(arg controller_state_topic)" />
    <param name="execution/leased_command_topic" value="$(arg leased_desired_topic)" />
    <param name="execution/external_safety_hold_topic"
           value="$(arg external_safety_hold_topic)" />
    <param name="execution/vbc_safety_hold_topic"
           value="$(arg vbc_safety_hold_topic)" />
  </node>

  <node if="$(arg use_acceleration_limiter)"
        pkg="egocentric_arm_planner"
        type="joint_velocity_rate_limiter_node.py"
        name="joint_velocity_rate_limiter"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="rate" value="100.0" />
    <param name="input_topic" value="$(arg output_velocity_command)" />
    <param name="output_topic" value="$(arg rate_limiter_output_velocity_command)" />
    <param name="stamped_output_topic" value="$(arg rate_limiter_stamped_output_velocity_command)" />
    <param name="summary_topic" value="/care_planner/execution/rate_limiter_summary" />
    <param name="input_timeout" value="0.10" />
    <param name="require_execution_lease" value="$(arg require_execution_lease)" />
    <param name="leased_input_topic" value="$(arg leased_desired_topic)" />
    <param name="leased_output_topic" value="$(arg leased_controller_command_topic)" />
    <param name="controller_state_topic" value="$(arg controller_state_topic)" />
    <param name="external_safety_hold_topic" value="$(arg external_safety_hold_topic)" />
    <param name="vbc_safety_hold_topic" value="$(arg vbc_safety_hold_topic)" />
  </node>
</launch>
