<launch>
  <!-- Reproducible Phase B.2-v2 A/B trial with visibility-before-contact gating. -->

  <arg name="config_file"
       default="$(find egocentric_arm_planner)/config/planner_phase1.yaml" />
  <arg name="base_frame" default="base_link" />
  <arg name="ee_frame" default="EE_link" />
  <arg name="use_trajectory_visualizer" default="true" />

  <arg name="lambda_vis" default="0.0" />
  <arg name="visibility_timeout" default="0.15" />
  <arg name="gradient_norm_clip" default="0.0" />
  <arg name="seen_threshold" default="0.50" />
  <arg name="gradient_normalization_eps" default="1e-6" />

  <arg name="vbc_min_margin_s" default="0.30" />
  <arg name="enable_executed_vbc_logger" default="true" />
  <arg name="executed_vbc_sweep_extra_margin" default="0.0" />

  <arg name="initial_prior_ready_topic"
       default="/care_planner/confidence_map/initial_prior_ready" />

  <arg name="enable_ab_logger" default="true" />
  <arg name="trial_label" default="" />
  <arg name="log_output_root"
       default="$(find egocentric_arm_planner)/../../outputs/phase_b2_v2_ab" />

  <arg name="goal_x" default="0.286881" />
  <arg name="goal_y" default="0.0" />
  <arg name="goal_z" default="0.560765" />
  <arg name="goal_qx" default="0.0" />
  <arg name="goal_qy" default="0.0" />
  <arg name="goal_qz" default="0.70710678" />
  <arg name="goal_qw" default="0.70710678" />
  <arg name="goal_delay" default="0.5" />

  <arg name="candidate_target_topic"
       default="/care_planner/active_sensing/target_candidate" />
  <arg name="legacy_candidate_target_topic"
       default="/care_planner/active_sensing/legacy_target_candidate" />
  <arg name="frozen_target_topic"
       default="/care_planner/active_sensing/target_point" />

  <include file="$(find egocentric_arm_planner)/launch/phaseB2_visibility_qp_mpc.launch">
    <arg name="config_file" value="$(arg config_file)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="ee_frame" value="$(arg ee_frame)" />
    <arg name="use_interactive_marker" value="false" />
    <arg name="use_trajectory_visualizer" value="$(arg use_trajectory_visualizer)" />
    <arg name="lambda_vis" value="$(arg lambda_vis)" />
    <arg name="visibility_timeout" value="$(arg visibility_timeout)" />
    <arg name="gradient_norm_clip" value="$(arg gradient_norm_clip)" />
    <arg name="active_target_topic" value="$(arg frozen_target_topic)" />
    <arg name="seen_threshold" value="$(arg seen_threshold)" />
    <arg name="gradient_normalization_eps" value="$(arg gradient_normalization_eps)" />
  </include>

  <include file="$(find care_confidence_map)/launch/confidence_map.launch">
    <arg name="initial_prior_ready_topic" value="$(arg initial_prior_ready_topic)" />
  </include>

  <!-- Legacy confidence/frontier analysis remains diagnostic only. -->
  <include file="$(find care_confidence_map)/launch/trajectory_risk.launch">
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="input_trajectory_topic" value="/care_planner/task_trajectory" />
    <arg name="active_sensing_target_topic" value="$(arg legacy_candidate_target_topic)" />
    <arg name="show_full_trajectory_markers" value="false" />
    <arg name="show_worst_timestep_markers" value="false" />
    <arg name="show_attribution_markers" value="false" />
  </include>

  <!-- VBC selector owns the real candidate topic. -->
  <include file="$(find care_confidence_map)/launch/trajectory_vbc_selector.launch">
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="input_trajectory_topic" value="/care_planner/task_trajectory" />
    <arg name="output_target_topic" value="$(arg candidate_target_topic)" />
    <arg name="confidence_query_service" value="/care_planner/confidence_map/query" />
    <arg name="min_visibility_before_sweep_margin_s" value="$(arg vbc_min_margin_s)" />
  </include>

  <!-- Executed VBC logger: actual-body TF sweep event + actual sensor-seen event. -->
  <include if="$(arg enable_executed_vbc_logger)"
           file="$(find care_confidence_map)/launch/executed_vbc_logger.launch">
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="target_topic" value="$(arg frozen_target_topic)" />
    <arg name="confidence_query_service" value="/care_planner/confidence_map/query" />
    <arg name="visibility_threshold" value="$(arg seen_threshold)" />
    <arg name="sweep_extra_margin" value="$(arg executed_vbc_sweep_extra_margin)" />
    <arg name="trial_label" value="$(arg trial_label)" />
    <arg name="lambda_vis" value="$(arg lambda_vis)" />
    <arg name="output_root" value="$(arg log_output_root)" />
  </include>

  <node pkg="egocentric_arm_planner"
        type="phase_b2_controlled_trial_node.py"
        name="phase_b2_controlled_trial"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="goal_topic" value="/care_planner/ee_target_pose" />
    <param name="candidate_topic" value="$(arg candidate_target_topic)" />
    <param name="frozen_target_topic" value="$(arg frozen_target_topic)" />
    <param name="require_initial_prior_ready" value="true" />
    <param name="initial_prior_ready_topic" value="$(arg initial_prior_ready_topic)" />
    <param name="publish_rate" value="20.0" />
    <param name="goal_delay" value="$(arg goal_delay)" />
    <param name="goal/x" value="$(arg goal_x)" />
    <param name="goal/y" value="$(arg goal_y)" />
    <param name="goal/z" value="$(arg goal_z)" />
    <param name="goal/qx" value="$(arg goal_qx)" />
    <param name="goal/qy" value="$(arg goal_qy)" />
    <param name="goal/qz" value="$(arg goal_qz)" />
    <param name="goal/qw" value="$(arg goal_qw)" />
  </node>

  <node if="$(arg enable_ab_logger)"
        pkg="egocentric_arm_planner"
        type="phase_b2_ab_logger_node.py"
        name="phase_b2_ab_logger"
        output="screen">
    <param name="trial_label" value="$(arg trial_label)" />
    <param name="lambda_vis" value="$(arg lambda_vis)" />
    <param name="output_root" value="$(arg log_output_root)" />
    <param name="target_topic" value="$(arg frozen_target_topic)" />
    <param name="mpc_summary_topic" value="/velocity_qp_mpc_node/summary" />
    <param name="adapter_summary_topic"
           value="/phase_b2_visibility_acquisition_adapter/summary" />
    <param name="observer_summary_topic" value="/ncdf_horizon_observer/summary" />
  </node>
</launch>
