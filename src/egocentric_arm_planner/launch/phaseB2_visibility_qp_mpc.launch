<launch>
  <!--
    Phase B.2 visibility steering on top of the Phase-A velocity QP-MPC.

    The frozen NCDF horizon observer runs separately in ncdf_l4c and publishes
    q_k, f_theta(x*,q_k), and grad_q f_theta for q1...qK.

    steering_mode=normalized_ascent reproduces legacy B.2-v2:
      r_k = grad/||grad||.

    steering_mode=projection_ascent is B.2-v3:
      far outside: normalized-Newton residual toward learned f=0;
      near/on positive side: fixed local +grad ascent residual;
      real confidence observation terminates acquisition.

    The adapter publishes r=[r1;...;rK] on configuration_target_residual_q.
    The existing condensed MPC input is internally still named "gradient_topic"
    for compatibility, but mathematically r is now the gradient of the
    first-order sequential linearization of a soft configuration-target cost.
  -->

  <arg name="config_file"
       default="$(find egocentric_arm_planner)/config/planner_phase1.yaml" />
  <arg name="base_frame" default="base_link" />
  <arg name="ee_frame" default="EE_link" />
  <arg name="use_interactive_marker" default="true" />
  <arg name="use_trajectory_visualizer" default="true" />

  <arg name="lambda_vis" default="0.10" />
  <arg name="visibility_timeout" default="0.15" />
  <arg name="gradient_norm_clip" default="0.0" />

  <arg name="steering_mode" default="projection_ascent" />
  <arg name="projection_epsilon_f" default="0.03" />
  <arg name="projection_damping" default="0.5" />
  <arg name="projection_max_step_norm" default="0.25" />
  <arg name="ascent_step_size" default="0.05" />
  <arg name="ascent_max_step_norm" default="0.25" />
  <arg name="legacy_ascent_scale" default="1.0" />

  <arg name="active_target_topic"
       default="/care_planner/active_sensing/target_point" />
  <arg name="observer_active_topic"
       default="/ncdf_horizon_observer/active" />
  <arg name="observer_horizon_q_topic"
       default="/ncdf_horizon_observer/horizon_q" />
  <arg name="observer_learned_values_topic"
       default="/ncdf_horizon_observer/learned_values" />
  <arg name="raw_visibility_gradient_topic"
       default="/ncdf_horizon_observer/gradient_q" />
  <arg name="visibility_active_topic"
       default="/care_planner/active_sensing/acquisition_active" />
  <arg name="visibility_steering_topic"
       default="/care_planner/active_sensing/configuration_target_residual_q" />
  <arg name="visibility_configuration_target_topic"
       default="/care_planner/active_sensing/configuration_target_q" />
  <arg name="normalized_gradient_diagnostic_topic"
       default="/care_planner/active_sensing/normalized_gradient_q" />
  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />
  <arg name="seen_threshold" default="0.50" />
  <arg name="gradient_normalization_eps" default="1e-8" />

  <include file="$(find egocentric_arm_planner)/launch/phase1_planner.launch">
    <arg name="config_file" value="$(arg config_file)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="ee_frame" value="$(arg ee_frame)" />
    <arg name="use_execution_manager" value="false" />
    <arg name="use_interactive_marker" value="$(arg use_interactive_marker)" />
    <arg name="use_trajectory_visualizer" value="$(arg use_trajectory_visualizer)" />
  </include>

  <node pkg="egocentric_arm_planner"
        type="phase_b2_visibility_acquisition_adapter_node.py"
        name="phase_b2_visibility_acquisition_adapter"
        output="screen">
    <param name="target_topic" value="$(arg active_target_topic)" />
    <param name="observer_active_topic" value="$(arg observer_active_topic)" />
    <param name="horizon_q_topic" value="$(arg observer_horizon_q_topic)" />
    <param name="learned_values_topic" value="$(arg observer_learned_values_topic)" />
    <param name="raw_gradient_topic" value="$(arg raw_visibility_gradient_topic)" />
    <param name="confidence_query_service" value="$(arg confidence_query_service)" />
    <param name="acquisition_active_topic" value="$(arg visibility_active_topic)" />
    <param name="steering_topic" value="$(arg visibility_steering_topic)" />
    <param name="configuration_target_topic" value="$(arg visibility_configuration_target_topic)" />
    <param name="normalized_gradient_topic" value="$(arg normalized_gradient_diagnostic_topic)" />
    <param name="seen_threshold" value="$(arg seen_threshold)" />
    <param name="normalization_eps" value="$(arg gradient_normalization_eps)" />
    <param name="steering_mode" value="$(arg steering_mode)" />
    <param name="projection_epsilon_f" value="$(arg projection_epsilon_f)" />
    <param name="projection_damping" value="$(arg projection_damping)" />
    <param name="projection_max_step_norm" value="$(arg projection_max_step_norm)" />
    <param name="ascent_step_size" value="$(arg ascent_step_size)" />
    <param name="ascent_max_step_norm" value="$(arg ascent_max_step_norm)" />
    <param name="legacy_ascent_scale" value="$(arg legacy_ascent_scale)" />
    <param name="rate" value="20.0" />
    <param name="target_timeout" value="0.25" />
    <param name="observer_timeout" value="$(arg visibility_timeout)" />
  </node>

  <node pkg="egocentric_arm_planner"
        type="velocity_qp_mpc_node"
        name="velocity_qp_mpc_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="ee_frame" value="$(arg ee_frame)" />
    <param name="mpc/reference_trajectory"
           value="/care_planner/command_trajectory_candidate" />

    <param name="mpc/visibility/enabled" value="true" />
    <param name="mpc/visibility/weight" value="$(arg lambda_vis)" />
    <param name="mpc/visibility/timeout" value="$(arg visibility_timeout)" />
    <param name="mpc/visibility/gradient_norm_clip"
           value="$(arg gradient_norm_clip)" />
    <param name="mpc/visibility/active_topic"
           value="$(arg visibility_active_topic)" />
    <!-- Legacy parameter name; input is steering residual r_k in B.2-v3. -->
    <param name="mpc/visibility/gradient_topic"
           value="$(arg visibility_steering_topic)" />
  </node>
</launch>
