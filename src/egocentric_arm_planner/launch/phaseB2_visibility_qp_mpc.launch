<launch>
  <!--
    Phase B.2-v2: Phase-A velocity QP-MPC + confidence-gated normalized
    visibility acquisition.

    The frozen NCDF horizon observer is intentionally NOT launched here because
    it runs in the dedicated ncdf_l4c conda environment. Start it separately:
      python src/care_visibility_cdf/scripts/ncdf_horizon_observer_node.py _device:=cpu

    The lightweight adapter launched below keeps the observer diagnostic-only:
      raw df/dq -> per-horizon unit direction
      confidence(target) < seen_threshold -> acquisition_active=true
      once seen -> latch acquisition_active=false until x* changes

    A running /care_planner/confidence_map/query service is required for the v2
    visibility term to activate. If the service is missing, the adapter fails
    closed and the MPC falls back to the Phase-A tracking objective.
  -->

  <arg name="config_file"
       default="$(find egocentric_arm_planner)/config/planner_phase1.yaml" />
  <arg name="base_frame" default="base_link" />
  <arg name="ee_frame" default="EE_link" />
  <arg name="use_interactive_marker" default="true" />
  <arg name="use_trajectory_visualizer" default="true" />

  <arg name="lambda_vis" default="0.10" />
  <arg name="visibility_timeout" default="0.15" />
  <arg name="gradient_norm_clip" default="0.0" />

  <arg name="active_target_topic"
       default="/care_planner/active_sensing/target_point" />
  <arg name="observer_active_topic"
       default="/ncdf_horizon_observer/active" />
  <arg name="raw_visibility_gradient_topic"
       default="/ncdf_horizon_observer/gradient_q" />
  <arg name="visibility_active_topic"
       default="/care_planner/active_sensing/acquisition_active" />
  <arg name="visibility_gradient_topic"
       default="/care_planner/active_sensing/normalized_gradient_q" />
  <arg name="confidence_query_service"
       default="/care_planner/confidence_map/query" />
  <arg name="seen_threshold" default="0.50" />
  <arg name="gradient_normalization_eps" default="1e-6" />

  <include file="$(find egocentric_arm_planner)/launch/phase1_planner.launch">
    <arg name="config_file" value="$(arg config_file)" />
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="ee_frame" value="$(arg ee_frame)" />
    <arg name="use_execution_manager" value="false" />
    <arg name="use_interactive_marker" value="$(arg use_interactive_marker)" />
    <arg name="use_trajectory_visualizer" value="$(arg use_trajectory_visualizer)" />
  </include>

  <node pkg="egocentric_arm_planner"
        type="phase_b2_visibility_acquisition_adapter_node.py"
        name="phase_b2_visibility_acquisition_adapter"
        output="screen">
    <param name="target_topic" value="$(arg active_target_topic)" />
    <param name="observer_active_topic" value="$(arg observer_active_topic)" />
    <param name="raw_gradient_topic" value="$(arg raw_visibility_gradient_topic)" />
    <param name="confidence_query_service" value="$(arg confidence_query_service)" />
    <param name="acquisition_active_topic" value="$(arg visibility_active_topic)" />
    <param name="normalized_gradient_topic" value="$(arg visibility_gradient_topic)" />
    <param name="seen_threshold" value="$(arg seen_threshold)" />
    <param name="normalization_eps" value="$(arg gradient_normalization_eps)" />
    <param name="rate" value="20.0" />
    <param name="target_timeout" value="0.25" />
    <param name="observer_timeout" value="$(arg visibility_timeout)" />
  </node>

  <node pkg="egocentric_arm_planner"
        type="velocity_qp_mpc_node"
        name="velocity_qp_mpc_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="ee_frame" value="$(arg ee_frame)" />
    <param name="mpc/reference_trajectory"
           value="/care_planner/command_trajectory_candidate" />

    <param name="mpc/visibility/enabled" value="true" />
    <param name="mpc/visibility/weight" value="$(arg lambda_vis)" />
    <param name="mpc/visibility/timeout" value="$(arg visibility_timeout)" />
    <param name="mpc/visibility/gradient_norm_clip"
           value="$(arg gradient_norm_clip)" />
    <param name="mpc/visibility/active_topic"
           value="$(arg visibility_active_topic)" />
    <param name="mpc/visibility/gradient_topic"
           value="$(arg visibility_gradient_topic)" />
  </node>
</launch>
