<?xml version="1.0"?>
<package format="2">
  <name>egocentric_arm_planner</name>
  <version>0.0.1</version>
  <description>CARE-Planner: confidence-aware receding-horizon planner for egocentric arm perception.</description>

  <maintainer email="songzhicheng66@gmail.com">zhicheng</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>arm_model</depend>
  <depend>arm_trajectory</depend>
  <depend>care_collision_cdf</depend>

  <depend>eigen</depend>

  <!-- Runtime-only tools used by the Phase-A/B diagnostic launches. -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>care_confidence_map</exec_depend>
</package>
